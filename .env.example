# Airtable Personal Access Token with read access to the base
AIRTABLE_API_KEY=

# Airtable base ID (e.g. appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=

# Table name to check (defaults to "Bookings" if unset)
AIRTABLE_TABLE_NAME=Bookings

# Slack Incoming Webhook URL for the alert channel
SLACK_WEBHOOK_URL=

# Minutes of leeway before a record is considered overdue (defaults to 60)
OVERDUE_LEEWAY_MINUTES=60
